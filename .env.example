# =============================================================================
# Medical RAG Chatbot - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!

# -----------------------------------------------------------------------------
# Google Gemini API Configuration (REQUIRED)
# -----------------------------------------------------------------------------
# Option 1: Use Google AI Studio API Key (Recommended for development)
# Get your key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here

# Option 2: Use Google Cloud Vertex AI (For production)
# Your GCP project ID (required for Vertex AI)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# GCP region for Vertex AI (default: us-central1)
GOOGLE_CLOUD_LOCATION=us-central1

# -----------------------------------------------------------------------------
# Gemini Model Configuration
# -----------------------------------------------------------------------------
# Gemini model to use
# Options: gemini-2.0-flash, gemini-1.5-pro, gemini-1.5-flash
GEMINI_MODEL=gemini-2.0-flash

# -----------------------------------------------------------------------------
# PubMed Configuration
# -----------------------------------------------------------------------------
# NCBI API key for higher rate limits (optional but HIGHLY recommended)
# Without API key: 3 requests/second
# With API key: 10 requests/second
# Get one FREE at: https://www.ncbi.nlm.nih.gov/account/settings/
PUBMED_API_KEY=your-ncbi-api-key-here

# PubMed E-utilities base URL (don't change unless necessary)
PUBMED_BASE_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils

# Maximum number of PubMed results per query (default: 10)
MAX_SEARCH_RESULTS=10

# -----------------------------------------------------------------------------
# Retry Configuration (for API resilience)
# -----------------------------------------------------------------------------
# Maximum retry attempts for transient errors (default: 3)
RETRY_MAX_ATTEMPTS=3

# Initial wait time in seconds for exponential backoff (default: 1.0)
RETRY_WAIT_SECONDS=1.0

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Streamlit Configuration (Optional)
# -----------------------------------------------------------------------------
# These can also be set in .streamlit/config.toml
# STREAMLIT_SERVER_PORT=8501
# STREAMLIT_SERVER_HEADLESS=true
